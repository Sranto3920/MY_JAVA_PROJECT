{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile JavaFX",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "/Library/Java/JavaVirtualMachines/liberica-jdk-21-full.jdk/Contents/Home/bin/javac --module-path ${workspaceFolder}/javafx-sdk-21.0.2/lib --add-modules javafx.controls,javafx.fxml -d out $(find . -name '*.java')"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$javac"
    },
    {
      "label": "Run AidAccessApp",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "/Library/Java/JavaVirtualMachines/liberica-jdk-21-full.jdk/Contents/Home/bin/java --module-path ${workspaceFolder}/javafx-sdk-21.0.2/lib --add-modules javafx.controls,javafx.fxml -cp out myProject.AidAccessApp"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Compile JavaFX"
    }
  ]
}
